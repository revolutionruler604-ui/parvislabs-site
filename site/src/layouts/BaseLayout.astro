---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  inner?: boolean;
}

const { title, description, home = false, inner = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href="/fonts/kaisei-opti-400.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="wrap">
      <header class="nav">
        <a class="wordmark" href="/">Parvis Labs</a>
        <a class="write" href="/#write">Write to us</a>
      </header>
      <main id="main" class={home ? 'home' : inner ? 'inner' : 'prose'}>
        <slot />
      </main>
      <footer class="foot">
        <span>Parvis Labs. Founder Sachin Kumar.</span>
        <nav>
          <a href="/method/">How the crew works</a>
          <a href="/principles/">Principles</a>
          <a href="/about/">About</a>
        </nav>
      </footer>
    </div>
  </body>
</html>
